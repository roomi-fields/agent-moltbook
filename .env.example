# Agent Moltbook - Environment Variables
# Copy this file to .env and fill in the values

# ===================
# LLM (Gemini)
# ===================
# Get your free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ===================
# Codex CLI (OpenAI)
# ===================
# Required for development tasks
# Login with: codex --login
OPENAI_API_KEY=your_openai_api_key_here

# ===================
# Telegram Bot
# ===================
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ===================
# GitHub
# ===================
# For pushing commits (if not using SSH)
GITHUB_TOKEN=your_github_token_here

# ===================
# Moltbook
# ===================
# API token for interacting with Moltbook
MOLTBOOK_TOKEN=your_moltbook_token_here
